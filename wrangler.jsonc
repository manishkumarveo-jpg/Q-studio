// Local development config only. Preview/staging/production get separate bindings in Phase 20.
// Secrets (OWNER_*, ALLOWED_ORIGINS) come from .dev.vars locally and `wrangler secret put` when deployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qc-studio",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qc-studio-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "database/migrations"
    }
  ],
  "vars": { "WORKSPACE_NAME": "QC Studio" }
}
